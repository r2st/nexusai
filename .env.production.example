# =============================================================================
# NexusAI Production Environment Configuration
# =============================================================================
#
# IMPORTANT SECURITY NOTES:
# 1. Copy this file to .env and update with your production values
# 2. NEVER commit the actual .env file to version control!
# 3. Generate all secrets using: openssl rand -base64 32
# 4. Use a secrets manager (Vault, AWS Secrets Manager, etc.) in production
# 5. Rotate secrets regularly
#
# =============================================================================

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info

# Your production domain (no trailing slash)
DOMAIN=nexusai.example.com

# Email for Let's Encrypt SSL certificates
ACME_EMAIL=admin@example.com

# Application version tag
VERSION=latest

# =============================================================================
# SECURITY - GENERATE NEW VALUES FOR PRODUCTION!
# =============================================================================
# Generate secrets with: openssl rand -base64 32

# JWT and encryption secret (REQUIRED - change this!)
SECRET_KEY=<GENERATE_WITH_openssl_rand_-base64_32>

# JWT settings
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================

POSTGRES_USER=nexusai
POSTGRES_PASSWORD=<GENERATE_SECURE_PASSWORD>
POSTGRES_DB=nexusai

# For managed databases (AWS RDS, Cloud SQL, etc.)
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/nexusai

# Connection pool (adjust based on your server resources)
DATABASE_POOL_SIZE=50
DATABASE_MAX_OVERFLOW=100

# Enable SSL for database connections
DATABASE_SSL_MODE=require

# Read replica for scaling reads (optional)
# DATABASE_READ_REPLICA_URL=postgresql+asyncpg://user:pass@replica:5432/nexusai

# =============================================================================
# REDIS
# =============================================================================

REDIS_PASSWORD=<GENERATE_SECURE_PASSWORD>

# For managed Redis (AWS ElastiCache, Redis Cloud, etc.)
# REDIS_URL=rediss://user:pass@host:6379/0

# Redis settings
REDIS_MAXMEMORY=1gb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed origins - supports JSON array OR comma-separated format
# JSON array: CORS_ORIGINS=["https://nexusai.example.com","https://api.nexusai.example.com"]
# Comma-separated: CORS_ORIGINS=https://nexusai.example.com,https://api.nexusai.example.com
CORS_ORIGINS=https://nexusai.example.com,https://api.nexusai.example.com

# =============================================================================
# BACKEND SETTINGS
# =============================================================================

# Number of Uvicorn workers (2-4 x CPU cores)
BACKEND_WORKERS=4

# Rate limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=5000

# Background task processing
TASK_QUEUE_ENABLED=true
TASK_WORKER_CONCURRENCY=20

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# API URL for client-side requests
NEXT_PUBLIC_API_URL=https://api.nexusai.example.com/api/v1

# Internal backend URL (Docker network)
BACKEND_INTERNAL_URL=http://backend:8000

# =============================================================================
# SEARCH (Meilisearch)
# =============================================================================

# Generate with: openssl rand -base64 32
MEILISEARCH_MASTER_KEY=<GENERATE_SECURE_KEY>
MEILISEARCH_API_KEY=<GENERATE_SECURE_KEY>
MEILISEARCH_URL=http://meilisearch:7700

# =============================================================================
# AI PROVIDERS
# =============================================================================

# Default AI Provider: openai, anthropic, google
# Just change this to switch providers - each has its own default model
DEFAULT_AI_PROVIDER=openai

# Fallback chain (comma-separated, tries each in order if primary fails)
AI_PROVIDER_FALLBACK=anthropic,google

# --- OpenAI (GPT-4) ---
OPENAI_API_KEY=sk-<YOUR_OPENAI_API_KEY>
OPENAI_DEFAULT_MODEL=gpt-4o

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-<YOUR_ANTHROPIC_API_KEY>
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514

# --- Google AI (Gemini) ---
GOOGLE_API_KEY=<YOUR_GOOGLE_API_KEY>
GOOGLE_DEFAULT_MODEL=gemini-2.0-flash-exp

# --- Azure OpenAI (alternative to OpenAI) ---
# AZURE_OPENAI_API_KEY=<YOUR_KEY>
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- AWS Bedrock ---
# AWS_ACCESS_KEY_ID=<YOUR_KEY>
# AWS_SECRET_ACCESS_KEY=<YOUR_SECRET>
# AWS_REGION=us-east-1

# =============================================================================
# STORAGE (Cloud Storage Recommended)
# =============================================================================

STORAGE_TYPE=s3

# AWS S3
S3_BUCKET_NAME=nexusai-files-prod
S3_REGION=us-east-1
S3_ACCESS_KEY=<YOUR_AWS_ACCESS_KEY>
S3_SECRET_KEY=<YOUR_AWS_SECRET_KEY>

# Or Azure Blob Storage
# STORAGE_TYPE=azure
# AZURE_STORAGE_CONNECTION_STRING=<YOUR_CONNECTION_STRING>
# AZURE_STORAGE_CONTAINER=nexusai

# Or Google Cloud Storage
# STORAGE_TYPE=gcs
# GCS_BUCKET_NAME=nexusai-files-prod
# GCS_PROJECT_ID=your-project
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# =============================================================================
# OAUTH PROVIDERS
# =============================================================================

# Google OAuth
GOOGLE_CLIENT_ID=<YOUR_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_CLIENT_SECRET>

# GitHub OAuth
GITHUB_CLIENT_ID=<YOUR_CLIENT_ID>
GITHUB_CLIENT_SECRET=<YOUR_CLIENT_SECRET>

# Microsoft Azure AD (Enterprise SSO)
# AZURE_AD_TENANT_ID=<YOUR_TENANT_ID>
# AZURE_AD_CLIENT_ID=<YOUR_CLIENT_ID>
# AZURE_AD_CLIENT_SECRET=<YOUR_CLIENT_SECRET>

# Okta (Enterprise SSO)
# OKTA_DOMAIN=your-domain.okta.com
# OKTA_CLIENT_ID=<YOUR_CLIENT_ID>
# OKTA_CLIENT_SECRET=<YOUR_CLIENT_SECRET>

# =============================================================================
# DEVLAKE (Engineering Analytics)
# =============================================================================

# Generate with: openssl rand -base64 32 | head -c 32
DEVLAKE_ENCRYPTION_SECRET=<GENERATE_32_CHAR_SECRET>
DEVLAKE_ADMIN_USER=admin
DEVLAKE_ADMIN_PASS=<GENERATE_SECURE_PASSWORD>

# =============================================================================
# GRAFANA (Dashboards)
# =============================================================================

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<GENERATE_SECURE_PASSWORD>

# OAuth for Grafana (optional)
# GRAFANA_CLIENT_SECRET=<YOUR_SECRET>

# =============================================================================
# MCP ERROR RECOVERY SETTINGS
# =============================================================================

# Auto-execute recovery actions (health checks, list resources) on tool failures
MCP_AUTO_EXECUTE_RECOVERY=true
# Maximum recovery depth to prevent infinite loops (1 = one recovery attempt)
MCP_MAX_RECOVERY_DEPTH=1

# =============================================================================
# OBSERVABILITY (OpenTelemetry)
# =============================================================================

OTEL_ENABLED=true
OTEL_SERVICE_NAME=nexusai-production
OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Sample 10% of traces in production
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# =============================================================================
# ENTERPRISE SECURITY (Optional)
# =============================================================================

# OpenBao / Vault (Secrets Management)
# OPENBAO_URL=https://vault.example.com:8200
# OPENBAO_TOKEN=<YOUR_TOKEN>
# OPENBAO_NAMESPACE=nexusai

# OpenFGA (Fine-Grained Authorization)
# OPENFGA_URL=http://openfga:8081
# OPENFGA_STORE_ID=<YOUR_STORE_ID>
# OPENFGA_MODEL_ID=<YOUR_MODEL_ID>

# Keycloak (Enterprise SSO)
# KEYCLOAK_URL=https://auth.example.com
# KEYCLOAK_REALM=nexusai
# KEYCLOAK_CLIENT_ID=nexusai-backend
# KEYCLOAK_CLIENT_SECRET=<YOUR_SECRET>

# =============================================================================
# CODE SANDBOX (Disable in production unless needed)
# =============================================================================

CODE_SANDBOX_ENABLED=false
# CODE_SANDBOX_URL=http://sandbox:8090
# SANDBOX_MAX_CONTAINERS=5
# SANDBOX_TIMEOUT=30
# SANDBOX_MEMORY_LIMIT=256m
# SANDBOX_CPU_LIMIT=0.5

# =============================================================================
# MULTI-TENANCY
# =============================================================================

MULTI_TENANT_ENABLED=true
DEFAULT_ORG_MAX_MEMBERS=50
DEFAULT_ORG_MAX_PROJECTS=20

# =============================================================================
# ALERTING & NOTIFICATIONS
# =============================================================================

# Slack alerts
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# PagerDuty
# PAGERDUTY_SERVICE_KEY=<YOUR_KEY>

# Email (SMTP)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=<YOUR_USER>
# SMTP_PASSWORD=<YOUR_PASSWORD>
# SMTP_FROM_EMAIL=noreply@nexusai.example.com

# =============================================================================
# FEATURE FLAGS
# =============================================================================

FEATURE_AI_ANALYTICS=true
FEATURE_CODE_SIMILARITY=true
FEATURE_PR_ISSUE_CORRELATION=true
FEATURE_SPACE_METRICS=true
FEATURE_BUSINESS_METRICS=true
FEATURE_PRODUCTIVITY_METRICS=true

# ChatInterface Features
FEATURE_CODE_INTERPRETER=false  # Disable for security
FEATURE_WEB_SEARCH=true
FEATURE_IMAGE_GENERATION=true
FEATURE_SPEECH_STT=true
FEATURE_SPEECH_TTS=true
FEATURE_MCP_TOOLS=true
FEATURE_AGENT_HANDOFF=true
FEATURE_GENERATIVE_UI=true
FEATURE_CONVERSATION_IMPORT=true
FEATURE_CONVERSATION_EXPORT=true

# =============================================================================
# PERSONAL ACCESS TOKENS
# =============================================================================

PAT_DEFAULT_EXPIRY_DAYS=90
PAT_MAX_TOKENS_PER_USER=10

# =============================================================================
# DOCKER COMPOSE
# =============================================================================

COMPOSE_PROJECT_NAME=nexusai-prod

# =============================================================================
# ADDITIONAL DATABASES (Optional)
# =============================================================================

# ClickHouse for analytics
# CLICKHOUSE_HOST=clickhouse
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_DATABASE=nexusai
# CLICKHOUSE_USER=nexusai
# CLICKHOUSE_PASSWORD=<GENERATE_SECURE_PASSWORD>

# =============================================================================
# BACKUP CONFIGURATION (Recommended)
# =============================================================================

# BACKUP_ENABLED=true
# BACKUP_S3_BUCKET=nexusai-backups
# BACKUP_RETENTION_DAYS=30
# BACKUP_ENCRYPTION_KEY=<GENERATE_SECURE_KEY>
