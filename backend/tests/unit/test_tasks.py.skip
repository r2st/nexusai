# =============================================================================
# TaskQueue Tests - Scheduling
# =============================================================================


class TestTaskQueueScheduling:
    """Tests for task scheduling."""

    @pytest.mark.asyncio
    async def test_schedule_with_run_at(self, connected_task_queue):
        """Test scheduling task for specific time."""
        mock_job = MagicMock()
        connected_task_queue._pool.enqueue_job = AsyncMock(return_value=mock_job)

        run_at = datetime.utcnow() + timedelta(hours=2)
        await connected_task_queue.schedule(
            "scheduled_task",
            run_at=run_at,
        )

        call_kwargs = connected_task_queue._pool.enqueue_job.call_args[1]
        assert call_kwargs["_queue_name"] == TaskConfig.SCHEDULED_QUEUE
        assert call_kwargs["_defer_until"] == run_at

    @pytest.mark.asyncio
    async def test_schedule_with_delay(self, connected_task_queue):
        """Test scheduling task with delay."""
        mock_job = MagicMock()
        connected_task_queue._pool.enqueue_job = AsyncMock(return_value=mock_job)

        delay = timedelta(minutes=30)
        await connected_task_queue.schedule(
            "delayed_task",
            delay=delay,
        )

        call_kwargs = connected_task_queue._pool.enqueue_job.call_args[1]
        assert call_kwargs["_defer_by"] == delay


# =============================================================================
# TaskQueue Tests - Job Management
# =============================================================================


class TestTaskQueueJobManagement:
    """Tests for job management."""

    @pytest.mark.asyncio
    async def test_get_job(self, connected_task_queue):
        """Test getting job by ID."""
        mock_job = MagicMock()
        connected_task_queue._pool.get_job = AsyncMock(return_value=mock_job)

        job = await connected_task_queue.get_job("job-123")

        connected_task_queue._pool.get_job.assert_called_once_with("job-123")
        assert job is mock_job

    @pytest.mark.asyncio
    async def test_get_job_result(self, connected_task_queue):
        """Test getting job result."""
        mock_job = MagicMock()
        mock_job.result = AsyncMock(return_value={"status": "completed"})
        connected_task_queue._pool.get_job = AsyncMock(return_value=mock_job)

        result = await connected_task_queue.get_job_result("job-123", timeout=10.0)

        mock_job.result.assert_called_once_with(timeout=10.0)
        assert result == {"status": "completed"}

    @pytest.mark.asyncio
    async def test_get_job_result_not_found(self, connected_task_queue):
        """Test getting result for non-existent job."""
        connected_task_queue._pool.get_job = AsyncMock(return_value=None)

        result = await connected_task_queue.get_job_result("nonexistent")

        assert result is None

    @pytest.mark.asyncio
    async def test_cancel_job(self, connected_task_queue):
        """Test canceling a job."""
        mock_job = MagicMock()
        mock_job.abort = AsyncMock()
        connected_task_queue._pool.get_job = AsyncMock(return_value=mock_job)

        result = await connected_task_queue.cancel_job("job-123")

        mock_job.abort.assert_called_once()
        assert result is True

    @pytest.mark.asyncio
    async def test_cancel_job_not_found(self, connected_task_queue):
        """Test canceling non-existent job."""
        connected_task_queue._pool.get_job = AsyncMock(return_value=None)

        result = await connected_task_queue.cancel_job("nonexistent")

        assert result is False


