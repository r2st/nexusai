class TestTaskQueueInfo:
    """Tests for queue information."""

    @pytest.mark.asyncio
    async def test_get_queue_info(self, connected_task_queue):
        """Test getting queue statistics."""
        connected_task_queue._pool.info = AsyncMock(return_value={
            "pending": 10,
            "complete": 100,
            "failed": 5,
        })

        info = await connected_task_queue.get_queue_info()

        assert info["pending"] == 10
        assert info["complete"] == 100
        assert info["failed"] == 5
        assert info["queue"] == TaskConfig.DEFAULT_QUEUE

    @pytest.mark.asyncio
    async def test_get_queue_info_custom_queue(self, connected_task_queue):
        """Test getting info for specific queue."""
        connected_task_queue._pool.info = AsyncMock(return_value={})

        info = await connected_task_queue.get_queue_info("custom:queue")

        assert info["queue"] == "custom:queue"


# =============================================================================
# TaskQueue Tests - Tenant-Aware Methods
# =============================================================================


class TestTaskQueueTenantAware:
    """Tests for tenant-aware task methods."""

    @pytest.mark.asyncio
    async def test_enqueue_for_tenant(self, connected_task_queue):
        """Test tenant-aware task enqueue."""
        mock_job = MagicMock()
        connected_task_queue._pool.enqueue_job = AsyncMock(return_value=mock_job)

        await connected_task_queue.enqueue_for_tenant(
            tenant_id="tenant-123",
            task_name="tenant_task",
            document_id="doc-456",
        )

        call_kwargs = connected_task_queue._pool.enqueue_job.call_args[1]
        # Should include tenant_id in kwargs
        assert call_kwargs.get("tenant_id") == "tenant-123"
        # Job ID should be prefixed with tenant
        assert "tenant:tenant-123:" in call_kwargs["_job_id"]

    @pytest.mark.asyncio
    async def test_enqueue_for_tenant_preserves_existing_tenant_id(self, connected_task_queue):
        """Test that existing tenant_id kwarg is not overwritten."""
        mock_job = MagicMock()
        connected_task_queue._pool.enqueue_job = AsyncMock(return_value=mock_job)

        await connected_task_queue.enqueue_for_tenant(
            tenant_id="tenant-123",
            task_name="tenant_task",
            tenant_id_override="different-tenant",  # Different key
        )

        call_kwargs = connected_task_queue._pool.enqueue_job.call_args[1]
        assert call_kwargs.get("tenant_id") == "tenant-123"

    @pytest.mark.asyncio
    async def test_get_tenant_jobs(self, connected_task_queue):
        """Test getting jobs for a tenant."""
        jobs = await connected_task_queue.get_tenant_jobs("tenant-123")

        # Currently returns empty list (needs Redis SCAN implementation)
        assert isinstance(jobs, list)

    @pytest.mark.asyncio
    async def test_cancel_tenant_jobs(self, connected_task_queue):
        """Test canceling all jobs for a tenant."""
        # With empty tenant jobs, should return 0
        cancelled = await connected_task_queue.cancel_tenant_jobs("tenant-123")

        assert cancelled == 0


# =============================================================================
# Decorator Tests
# =============================================================================


class TestBackgroundTaskDecorator:
    """Tests for background_task decorator."""

    def test_decorator_adds_metadata(self):
        """Test decorator adds task metadata."""
        @background_task(queue="custom:queue", timeout=120, max_tries=5)
        async def test_task(ctx):
            return "result"

        assert test_task._task_queue == "custom:queue"
        assert test_task._task_timeout == 120
        assert test_task._task_max_tries == 5
        assert test_task._is_background_task is True

    def test_decorator_default_values(self):
        """Test decorator default values."""
        @background_task()
        async def test_task(ctx):
            return "result"

        assert test_task._task_queue == TaskConfig.DEFAULT_QUEUE
        assert test_task._task_timeout == TaskConfig.DEFAULT_TIMEOUT
        assert test_task._task_max_tries == TaskConfig.MAX_RETRIES

    @pytest.mark.asyncio
    async def test_decorated_function_callable(self):
        """Test decorated function is still callable."""
        @background_task()
        async def test_task(ctx, value):
            return value * 2

        result = await test_task({}, 5)

        assert result == 10


class TestTenantBackgroundTaskDecorator:
    """Tests for tenant_background_task decorator."""

    def test_decorator_adds_tenant_metadata(self):
        """Test decorator adds tenant task metadata."""
        @tenant_background_task(queue="tenant:queue")
        async def tenant_task(ctx, tenant_id):
            return "result"

        assert tenant_task._is_tenant_task is True
        assert tenant_task._task_queue == "tenant:queue"

    @pytest.mark.asyncio
    async def test_sets_tenant_context(self):
        """Test decorator sets tenant context."""
        context_tenant_id = None

        @tenant_background_task()
        async def tenant_task(ctx, tenant_id):
            nonlocal context_tenant_id
            context_tenant_id = ctx.get("tenant_id")
            return "result"

        with patch("app.core.tasks.set_current_tenant_id") as mock_set:
            with patch("app.core.tasks.clear_tenant_context"):
                await tenant_task({}, tenant_id="test-tenant")

                mock_set.assert_called_with("test-tenant")

    @pytest.mark.asyncio
    async def test_clears_tenant_context_on_completion(self):
        """Test decorator clears tenant context on completion."""
        @tenant_background_task()
        async def tenant_task(ctx, tenant_id):
            return "result"

        with patch("app.core.tasks.set_current_tenant_id"):
            with patch("app.core.tasks.clear_tenant_context") as mock_clear:
                await tenant_task({}, tenant_id="test-tenant")

                mock_clear.assert_called_once()

    @pytest.mark.asyncio
    async def test_clears_tenant_context_on_error(self):
        """Test decorator clears tenant context even on error."""
        @tenant_background_task()
        async def failing_task(ctx, tenant_id):
            raise ValueError("Task failed")

        with patch("app.core.tasks.set_current_tenant_id"):
            with patch("app.core.tasks.clear_tenant_context") as mock_clear:
                with pytest.raises(ValueError):
                    await failing_task({}, tenant_id="test-tenant")

                mock_clear.assert_called_once()


# =============================================================================
# WorkerSettings Tests
# =============================================================================


class TestWorkerSettings:
    """Tests for WorkerSettings configuration."""

    def test_worker_has_redis_settings(self):
        """Test worker has Redis settings."""
        assert WorkerSettings.redis_settings is not None

    def test_worker_has_functions(self):
        """Test worker has task functions registered."""
        assert len(WorkerSettings.functions) > 0

    def test_worker_has_lifecycle_hooks(self):
        """Test worker has lifecycle hooks."""
        assert WorkerSettings.on_startup is not None
        assert WorkerSettings.on_shutdown is not None

    def test_worker_settings(self):
        """Test worker configuration settings."""
        assert WorkerSettings.max_jobs > 0
        assert WorkerSettings.job_timeout > 0
        assert WorkerSettings.keep_result > 0
        assert WorkerSettings.retry_jobs is True
        assert WorkerSettings.max_tries > 0


