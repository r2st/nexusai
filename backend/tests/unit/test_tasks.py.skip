"""
Unit tests for background task processing module.
"""

import asyncio
from datetime import datetime, timedelta
from unittest.mock import AsyncMock, MagicMock, patch
import uuid

import pytest

from app.core.tasks import (
    TaskPriority,
    TaskConfig,
    TaskQueue,
    task_queue,
    get_redis_settings,
    background_task,
    tenant_background_task,
    WorkerSettings,
)


# =============================================================================
# Fixtures
# =============================================================================


@pytest.fixture
def mock_task_queue():
    """Create a mock task queue."""
    queue = TaskQueue()
    queue._pool = AsyncMock()
    return queue


@pytest.fixture
def connected_task_queue():
    """Create a connected task queue with mocked pool."""
    queue = TaskQueue()
    queue._pool = AsyncMock()
    return queue


# =============================================================================
# TaskPriority Tests
# =============================================================================


class TestTaskPriority:
    """Tests for TaskPriority constants."""

    def test_priority_levels_defined(self):
        """Test all priority levels are defined."""
        assert TaskPriority.CRITICAL == "critical"
        assert TaskPriority.HIGH == "high"
        assert TaskPriority.NORMAL == "normal"
        assert TaskPriority.LOW == "low"
        assert TaskPriority.BULK == "bulk"


# =============================================================================
# TaskConfig Tests
# =============================================================================


class TestTaskConfig:
    """Tests for TaskConfig constants."""

    def test_queue_names_defined(self):
        """Test queue names are defined."""
        assert TaskConfig.DEFAULT_QUEUE == "nexusai:default"
        assert TaskConfig.HIGH_PRIORITY_QUEUE == "nexusai:high"
        assert TaskConfig.LOW_PRIORITY_QUEUE == "nexusai:low"
        assert TaskConfig.SCHEDULED_QUEUE == "nexusai:scheduled"

    def test_retry_settings(self):
        """Test retry settings are defined."""
        assert TaskConfig.MAX_RETRIES == 3
        assert TaskConfig.RETRY_DELAY == 60
        assert TaskConfig.RETRY_BACKOFF == 2

    def test_job_settings(self):
        """Test job settings are defined."""
        assert TaskConfig.DEFAULT_TIMEOUT == 300  # 5 minutes
        assert TaskConfig.RESULT_TTL == 3600  # 1 hour


# =============================================================================
# get_redis_settings Tests
# =============================================================================


class TestGetRedisSettings:
    """Tests for get_redis_settings function."""

    def test_returns_redis_settings(self):
        """Test that function returns RedisSettings."""
        from arq.connections import RedisSettings

        settings = get_redis_settings()

        assert isinstance(settings, RedisSettings)

    def test_uses_settings_values(self):
        """Test that function uses app settings."""
        with patch("app.core.tasks.settings") as mock_settings:
            mock_settings.REDIS_HOST = "test-redis"
            mock_settings.REDIS_PORT = 6380
            mock_settings.REDIS_PASSWORD = "test-pass"
            mock_settings.REDIS_DB = 2

            settings = get_redis_settings()

            assert settings.host == "test-redis"
            assert settings.port == 6380
            assert settings.password == "test-pass"
            # Database should be REDIS_DB + 1 for tasks
            assert settings.database == 3


# =============================================================================
# TaskQueue Tests - Connection
# =============================================================================


class TestTaskQueueConnection:
    """Tests for TaskQueue connection management."""

    @pytest.mark.asyncio
    async def test_connect(self):
        """Test connecting to Redis."""
        queue = TaskQueue()

        with patch("app.core.tasks.create_pool", new_callable=AsyncMock) as mock_create:
            mock_pool = AsyncMock()
            mock_create.return_value = mock_pool

            await queue.connect()

            mock_create.assert_called_once()
            assert queue._pool is mock_pool

    @pytest.mark.asyncio
    async def test_connect_idempotent(self):
        """Test that connect is idempotent."""
        queue = TaskQueue()
        mock_pool = AsyncMock()
        queue._pool = mock_pool

        with patch("app.core.tasks.create_pool", new_callable=AsyncMock) as mock_create:
            await queue.connect()

            mock_create.assert_not_called()

    @pytest.mark.asyncio
    async def test_disconnect(self):
        """Test disconnecting from Redis."""
        queue = TaskQueue()
        mock_pool = AsyncMock()
        queue._pool = mock_pool

        await queue.disconnect()

        mock_pool.close.assert_called_once()
        assert queue._pool is None

    @pytest.mark.asyncio
    async def test_disconnect_when_not_connected(self):
        """Test disconnect when not connected."""
        queue = TaskQueue()

        # Should not raise
        await queue.disconnect()

    def test_pool_property_raises_when_not_connected(self):
        """Test pool property raises when not connected."""
        queue = TaskQueue()

        with pytest.raises(RuntimeError) as exc_info:
            _ = queue.pool

        assert "not connected" in str(exc_info.value)


# =============================================================================
# TaskQueue Tests - Enqueue
# =============================================================================


class TestTaskQueueEnqueue:
    """Tests for TaskQueue enqueue methods."""

    @pytest.mark.asyncio
    async def test_enqueue_basic(self, connected_task_queue):
        """Test basic task enqueue."""
        mock_job = MagicMock()
        connected_task_queue._pool.enqueue_job = AsyncMock(return_value=mock_job)

        job = await connected_task_queue.enqueue(
            "test_task",
            "arg1",
            "arg2",
            kwarg1="value1",
        )

        connected_task_queue._pool.enqueue_job.assert_called_once()
        assert job is mock_job

    @pytest.mark.asyncio
    async def test_enqueue_with_custom_queue(self, connected_task_queue):
        """Test enqueue with custom queue name."""
        mock_job = MagicMock()
        connected_task_queue._pool.enqueue_job = AsyncMock(return_value=mock_job)

        await connected_task_queue.enqueue(
            "test_task",
            _queue_name="custom:queue",
        )

        call_kwargs = connected_task_queue._pool.enqueue_job.call_args[1]
        assert call_kwargs["_queue_name"] == "custom:queue"

    @pytest.mark.asyncio
    async def test_enqueue_with_defer_by(self, connected_task_queue):
        """Test enqueue with defer_by."""
        mock_job = MagicMock()
        connected_task_queue._pool.enqueue_job = AsyncMock(return_value=mock_job)

        delay = timedelta(minutes=5)
        await connected_task_queue.enqueue(
            "test_task",
            _defer_by=delay,
        )

        call_kwargs = connected_task_queue._pool.enqueue_job.call_args[1]
        assert call_kwargs["_defer_by"] == delay

    @pytest.mark.asyncio
    async def test_enqueue_with_defer_until(self, connected_task_queue):
        """Test enqueue with defer_until."""
        mock_job = MagicMock()
        connected_task_queue._pool.enqueue_job = AsyncMock(return_value=mock_job)

        run_at = datetime.utcnow() + timedelta(hours=1)
        await connected_task_queue.enqueue(
            "test_task",
            _defer_until=run_at,
        )

        call_kwargs = connected_task_queue._pool.enqueue_job.call_args[1]
        assert call_kwargs["_defer_until"] == run_at

    @pytest.mark.asyncio
    async def test_enqueue_with_custom_job_id(self, connected_task_queue):
        """Test enqueue with custom job ID."""
        mock_job = MagicMock()
        connected_task_queue._pool.enqueue_job = AsyncMock(return_value=mock_job)

        await connected_task_queue.enqueue(
            "test_task",
            _job_id="custom-job-123",
        )

        call_kwargs = connected_task_queue._pool.enqueue_job.call_args[1]
        assert call_kwargs["_job_id"] == "custom-job-123"

    @pytest.mark.asyncio
    async def test_enqueue_generates_job_id(self, connected_task_queue):
        """Test that enqueue generates job ID if not provided."""
        mock_job = MagicMock()
        connected_task_queue._pool.enqueue_job = AsyncMock(return_value=mock_job)

        await connected_task_queue.enqueue("test_task")

        call_kwargs = connected_task_queue._pool.enqueue_job.call_args[1]
        assert call_kwargs["_job_id"] is not None
        # Should be a valid UUID
        uuid.UUID(call_kwargs["_job_id"])


