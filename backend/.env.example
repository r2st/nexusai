# NexusAI Backend Configuration
# Copy this file to .env and update values as needed

# =============================================================================
# Application
# =============================================================================
APP_NAME=NexusAI
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development
SECRET_KEY=dev-secret-key-change-in-production-use-secrets-manager

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=true

# CORS - supports JSON array OR comma-separated format
# JSON array: CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
# Comma-separated: CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
# Option 1: Individual settings (recommended for development)
DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=nexusai

# Option 2: Full connection URL (overrides individual settings if set)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/nexusai

# Connection pool settings
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# =============================================================================
# Redis
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Or provide full URL:
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Authentication
# =============================================================================
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =============================================================================
# AI Providers
# =============================================================================
# Just change DEFAULT_AI_PROVIDER to switch - each provider has its own default model

# Default AI Provider: openai, anthropic, google, ollama
DEFAULT_AI_PROVIDER=google
AI_PROVIDER_FALLBACK=anthropic,openai,ollama

# --- Google AI (Gemini) - FREE TIER: 60 req/min ---
# Get key: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key
GOOGLE_DEFAULT_MODEL=gemini-2.5-flash

# --- Anthropic (Claude) - Paid ---
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514

# --- OpenAI (GPT-4) - Paid ---
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_API_BASE=
OPENAI_DEFAULT_MODEL=gpt-4o

# --- Groq (Ultra-fast) - FREE TIER: 30 req/min ---
# Get key: https://console.groq.com
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# --- Ollama (Local LLM) - FREE & UNLIMITED ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# =============================================================================
# Vector Store / Embeddings
# =============================================================================
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# =============================================================================
# File Upload
# =============================================================================
MAX_UPLOAD_SIZE=52428800
UPLOAD_DIR=./uploads

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
PER_TENANT_RATE_LIMIT=1000
PER_USER_RATE_LIMIT=100
WS_IDLE_TIMEOUT_SECONDS=120
WS_RATE_LIMIT_WINDOW_SECONDS=60
WS_MAX_MESSAGES_PER_WINDOW=120

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# Multi-tenancy
# =============================================================================
MULTI_TENANT_ENABLED=true
DEFAULT_ORG_MAX_MEMBERS=5
DEFAULT_ORG_MAX_PROJECTS=3

# =============================================================================
# Trial Settings
# =============================================================================
TRIAL_DURATION_DAYS=14
TRIAL_TIER=professional
TRIAL_MAX_MEMBERS=50
TRIAL_MAX_PROJECTS=20
TRIAL_REMINDER_DAYS=3

# Tier Limits
FREE_TIER_MAX_MEMBERS=5
FREE_TIER_MAX_PROJECTS=3
STARTER_TIER_MAX_MEMBERS=10
STARTER_TIER_MAX_PROJECTS=10
PROFESSIONAL_TIER_MAX_MEMBERS=50
PROFESSIONAL_TIER_MAX_PROJECTS=50
ENTERPRISE_TIER_MAX_MEMBERS=1000
ENTERPRISE_TIER_MAX_PROJECTS=500

# =============================================================================
# DevLake Integration (optional)
# =============================================================================
# Use 'nexusai-devlake' when running in Docker, 'localhost' for local development
DEVLAKE_API_URL=http://nexusai-devlake:8080
DEVLAKE_ENABLED=false
DEVLAKE_UI_URL=http://localhost:4000
GRAFANA_URL=http://localhost:3002
GRAFANA_ADMIN_TOKEN=your-grafana-admin-token-here

# DevLake MySQL Database (for direct DORA metrics queries)
# These connect to the DevLake MySQL container for PR-based DORA calculations
DEVLAKE_MYSQL_HOST=localhost
DEVLAKE_MYSQL_PORT=3306
DEVLAKE_MYSQL_USER=root
DEVLAKE_MYSQL_PASSWORD=admin
DEVLAKE_MYSQL_DB=lake

# =============================================================================
# Background Tasks
# =============================================================================
TASK_QUEUE_ENABLED=true
TASK_WORKER_CONCURRENCY=10
TASK_QUEUE_MAX_JOBS=100
TASK_QUEUE_JOB_TIMEOUT=300

# =============================================================================
# Feature Flags
# =============================================================================
FEATURE_AI_ANALYTICS=true
FEATURE_CODE_SIMILARITY=false
FEATURE_CODE_INTERPRETER=true
FEATURE_WEB_SEARCH=true
FEATURE_IMAGE_GENERATION=true
FEATURE_MCP_TOOLS=true
FEATURE_AGENT_HANDOFF=true
FEATURE_KNOWLEDGE_GRAPH=false
FEATURE_DEVOPS_AGENTS=true

# =============================================================================
# Optional Services (disabled by default for simpler setup)
# =============================================================================

# Neo4j Knowledge Graph
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=nexusai

# ClickHouse Analytics
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=nexusai
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# Code Sandbox
CODE_SANDBOX_ENABLED=false
CODE_SANDBOX_URL=http://localhost:8090

# MCP (Model Context Protocol)
MCP_ENABLED=true
MCP_DEFAULT_TIMEOUT=30
MCP_MAX_CONNECTIONS=10

# MCP Error Recovery Settings
# Auto-execute recovery actions (health checks, list resources) on tool failures
MCP_AUTO_EXECUTE_RECOVERY=true
# Maximum recovery depth to prevent infinite loops (1 = one recovery attempt)
MCP_MAX_RECOVERY_DEPTH=1

# Guardrails
GUARDRAILS_ENABLED=true
NEMO_GUARDRAILS_ENABLED=false
# Path to NeMo Guardrails config directory (contains config.yml/rails files)
NEMO_GUARDRAILS_CONFIG_PATH=./guardrails
# JSON map for per-tenant overrides, e.g. {"tenant-a":{"injection_block_threshold":0.9}}
GUARDRAILS_TENANT_POLICIES={}
# Streaming safety holdback window to avoid emitting unsafe partial content
GUARDRAILS_STREAM_HOLDBACK_CHARS=80

# =============================================================================
# Langfuse (LLM Observability & Debugging)
# =============================================================================
# Get API keys from: Project → Settings in your Langfuse dashboard
# Dashboard: https://us.cloud.langfuse.com (US) or https://cloud.langfuse.com (EU)
# 
# Project Info:
# - Project: nexus-ai (cmkqa2jtm08oyad076ajdq2ir)
# - Organization: nexus-ai (cmkqa2c2409osad0832hpg09n)
# - Cloud Region: US
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
# US region: https://us.cloud.langfuse.com
# EU region: https://cloud.langfuse.com
LANGFUSE_HOST=https://us.cloud.langfuse.com
# Optional: Project and Organization IDs (for reference/logging)
LANGFUSE_PROJECT_ID=your-project-id
LANGFUSE_ORG_ID=your-org-id

# OpenTelemetry (Observability)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=nexusai-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# =============================================================================
# E2E Testing - DevLake
# =============================================================================
# GitHub credentials for DevLake E2E tests (use your own for testing)
DEVLAKE_TEST_GITHUB_TOKEN=ghp_your-github-token-here
DEVLAKE_TEST_GITHUB_REPO=your-org/your-repo
DEVLAKE_TEST_PROJECT_NAME=test-project

# =============================================================================
# DORA Metrics Testing
# =============================================================================
# GitHub token for DORA metrics integration tests
GITHUB_TOKEN=ghp_your-github-token-here
GH_TOKEN=ghp_your-github-token-here

# Project configuration for DORA metrics
DORA_TEST_GITHUB_REPO=owner/repo-name
DORA_TEST_PROJECT_NAME=your-project-name

# =============================================================================
# Agents Configuration
# =============================================================================
AGENTS_ENABLED=true
AGENT_DEFAULT_LLM_PROVIDER=google
AGENT_DEFAULT_LLM_MODEL=gemini-2.5-flash
AGENT_MAX_EXECUTION_TIME=300
AGENT_MAX_STEPS=20
AGENT_MEMORY_ENABLED=true

# DevOps Agents
DEVOPS_AGENTS_ENABLED=true
DORA_METRICS_CACHE_TTL=3600
ADOPTION_METRICS_CACHE_TTL=3600

# OpenAPI Actions
OPENAPI_ACTIONS_ENABLED=true
OPENAPI_ACTION_TIMEOUT=30
OPENAPI_ACTION_RATE_LIMIT=60

# =============================================================================
# Hallucination Detection (Phoenix / Arize AI)
# =============================================================================
HALLUCINATION_DETECTION_ENABLED=true
HALLUCINATION_SCORE_THRESHOLD=0.7
HALLUCINATION_CHECK_RAG_RESPONSES=true
# HALLUCINATION_EVAL_MODEL=  # Defaults to configured LLM

# Phoenix (Arize AI)
PHOENIX_ENABLED=false
# PHOENIX_ENDPOINT=http://localhost:6006  # Local, or https://app.phoenix.arize.com for cloud
# PHOENIX_API_KEY=  # Required for Phoenix Cloud
PHOENIX_PROJECT_NAME=nexusai

# =============================================================================
# Additional AI Providers (all optional)
# =============================================================================

# Azure OpenAI
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
# AZURE_OPENAI_DEPLOYMENT=

# AWS Bedrock
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Google Vertex AI
# GOOGLE_VERTEX_PROJECT_ID=
# GOOGLE_VERTEX_LOCATION=us-central1

# Other providers
# MISTRAL_API_KEY=
# COHERE_API_KEY=
# TOGETHER_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# PERPLEXITY_API_KEY=

# =============================================================================
# Search Providers (optional - for web search tool)
# =============================================================================
# TAVILY_API_KEY=
# SERP_API_KEY=
# BRAVE_API_KEY=
# JINA_API_KEY=

# =============================================================================
# Cloud Storage (optional - defaults to local filesystem)
# =============================================================================

# S3-compatible storage
# S3_BUCKET_NAME=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT_URL=  # For MinIO or other S3-compatible services
# S3_DEFAULT=false

# Azure Blob Storage
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=nexusai
# AZURE_STORAGE_DEFAULT=false

# Google Cloud Storage
# GCS_BUCKET_NAME=
# GCS_PROJECT_ID=
# GCS_CREDENTIALS_PATH=
# GCS_DEFAULT=false

# =============================================================================
# Database Scalability (production tuning)
# =============================================================================
# DATABASE_READ_REPLICA_URL=  # Read replica for query load distribution
# DATABASE_POOL_TIMEOUT=30
# DATABASE_POOL_RECYCLE=1800
# DATABASE_STATEMENT_TIMEOUT=30000  # ms
# DATABASE_LOCK_TIMEOUT=10000  # ms

# =============================================================================
# Keycloak SSO (optional)
# =============================================================================
# KEYCLOAK_URL=
# KEYCLOAK_REALM=nexusai
# KEYCLOAK_CLIENT_ID=
# KEYCLOAK_CLIENT_SECRET=

# =============================================================================
# Secret Management (optional)
# =============================================================================
# OPENBAO_URL=
# OPENBAO_TOKEN=
# OPENFGA_URL=
# OPENFGA_STORE_ID=
