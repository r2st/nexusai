# =============================================================================
# NexusAI Environment Configuration
# =============================================================================
# Copy this file to .env and update values as needed.
# These defaults work out of the box with docker-compose for development.
#
# For production, ensure you:
# 1. Change all default passwords and secrets
# 2. Set ENVIRONMENT=production
# 3. Configure proper SSL/TLS
# 4. Set up proper database backups
# =============================================================================

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment: development, staging, production
ENVIRONMENT=development

# Debug mode (disable in production)
DEBUG=true

# Log level: debug, info, warning, error, critical
LOG_LEVEL=debug

# Secret key for JWT tokens and encryption (CHANGE IN PRODUCTION!)
SECRET_KEY=dev-secret-key-change-in-production-use-32-chars

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================

# Application database connection
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=nexusai
DATABASE_HOST=localhost
DATABASE_PORT=5434

# Full connection URL (constructed from above, or set directly)
# For Docker: use 'postgres' as host
# For local: use 'localhost' with exposed port
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/nexusai

# Docker Compose PostgreSQL settings (must match above)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nexusai

# Connection pool settings
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_USE_NULL_POOL=false

# Read replica (optional, for horizontal scaling)
# DATABASE_READ_REPLICA_URL=postgresql+asyncpg://user:pass@replica:5432/nexusai

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Redis memory limits
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed origins for CORS - supports JSON array OR comma-separated format
# JSON array: CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
# Comma-separated: CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# SERVICE PORTS
# =============================================================================

BACKEND_PORT=8000
FRONTEND_PORT=3000
MEILISEARCH_PORT=7700

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# API URL for frontend (client-side requests)
# Use relative path for Next.js proxy: /api/v1
# Use full URL for direct access: http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=/api/v1

# Backend URL for server-side requests (Docker internal network)
BACKEND_INTERNAL_URL=http://backend:8000

# Optional external service URLs
NEXT_PUBLIC_DEVLAKE_URL=http://localhost:4000
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3002

# =============================================================================
# AI PROVIDER API KEYS
# =============================================================================
#
# At least one AI provider is required. Options:
#
# FREE OPTIONS (no credit card required):
# ┌─────────────────┬────────────────────────────────────────────────────────┐
# │ Provider        │ Free Tier Details                                      │
# ├─────────────────┼────────────────────────────────────────────────────────┤
# │ Ollama (local)  │ UNLIMITED - runs locally, no API key needed            │
# │ Google Gemini   │ 60 req/min - https://makersuite.google.com/app/apikey  │
# │ Groq            │ 30 req/min - https://console.groq.com                  │
# │ Together AI     │ $25 credit - https://api.together.xyz                  │
# │ OpenRouter      │ Free models - https://openrouter.ai                    │
# │ DeepSeek        │ Limited free - https://platform.deepseek.com           │
# └─────────────────┴────────────────────────────────────────────────────────┘
#
# RECOMMENDED SETUP:
# 1. Local/Unlimited: Use Ollama (make ollama-up && make ollama-pull MODEL=llama3.2)
# 2. Cloud Free Tier: Get a Groq or Google Gemini API key
# =============================================================================

# Default AI Provider: openai, anthropic, google, ollama
# Just change this to switch providers - each has its own default model configured below
DEFAULT_AI_PROVIDER=google

# Fallback chain (comma-separated, tries each in order if primary fails)
AI_PROVIDER_FALLBACK=anthropic,ollama,openai

# --- OpenAI (GPT-4, GPT-4o) - Paid ---
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_DEFAULT_MODEL=gpt-4o

# --- Anthropic (Claude) - Paid ---
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514

# --- Google AI (Gemini) - FREE TIER: 60 req/min ---
# Get key: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key
GOOGLE_DEFAULT_MODEL=gemini-2.0-flash-exp

# --- Groq (Ultra-fast) - FREE TIER: 30 req/min ---
# Get key: https://console.groq.com
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# --- Ollama (Local LLM) - FREE & UNLIMITED ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2
OLLAMA_PORT=11434
OLLAMA_WEBUI_PORT=3003

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- AWS Bedrock ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Mistral AI ---
MISTRAL_API_KEY=

# --- Together AI - FREE: $25 credit ---
TOGETHER_API_KEY=

# --- OpenRouter - FREE: Some models ---
OPENROUTER_API_KEY=

# --- DeepSeek - FREE TIER available ---
DEEPSEEK_API_KEY=

# --- Cohere ---
COHERE_API_KEY=

# --- Perplexity ---
PERPLEXITY_API_KEY=

# =============================================================================
# SEARCH & DISCOVERY
# =============================================================================

# Meilisearch (Full-text search)
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=nexusai-meilisearch-key
MEILISEARCH_API_KEY=nexusai-meilisearch-key

# Web Search Providers
TAVILY_API_KEY=
SERPAPI_API_KEY=
BRAVE_SEARCH_API_KEY=
JINA_API_KEY=

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================

# Storage type: local, s3, azure, gcs
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./uploads

# AWS S3 / MinIO
S3_BUCKET_NAME=nexusai-files
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=

# MinIO (Local S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=nexusai

# Google Cloud Storage
GCS_BUCKET_NAME=
GCS_PROJECT_ID=
GCS_CREDENTIALS_PATH=

# =============================================================================
# OAUTH & AUTHENTICATION
# =============================================================================

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Microsoft Azure AD
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# Okta
OKTA_DOMAIN=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=

# =============================================================================
# DEVLAKE (Engineering Analytics & DORA Metrics)
# =============================================================================

# DevLake API URL - this is where the DevLake backend API runs
DEVLAKE_API_URL=http://localhost:8080
DEVLAKE_ENABLED=true

DEVLAKE_ENCRYPTION_SECRET=change-this-to-32-char-secret!!
DEVLAKE_ADMIN_USER=admin
DEVLAKE_ADMIN_PASS=admin

# Grafana Dashboard
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# DevLake MySQL Database (for direct DORA metrics queries)
DEVLAKE_MYSQL_HOST=localhost
DEVLAKE_MYSQL_PORT=3306
DEVLAKE_MYSQL_USER=root
DEVLAKE_MYSQL_PASSWORD=admin
DEVLAKE_MYSQL_DB=lake

# =============================================================================
# MCP ERROR RECOVERY SETTINGS
# =============================================================================

# Auto-execute recovery actions (health checks, list resources) on tool failures
MCP_AUTO_EXECUTE_RECOVERY=true
# Maximum recovery depth to prevent infinite loops (1 = one recovery attempt)
MCP_MAX_RECOVERY_DEPTH=1

# =============================================================================
# ENTERPRISE SECURITY (Optional)
# =============================================================================

# OpenBao (Secret Management - Vault fork)
OPENBAO_URL=http://localhost:8200
OPENBAO_TOKEN=dev-root-token
OPENBAO_NAMESPACE=

# OpenFGA (Fine-Grained Authorization)
OPENFGA_URL=http://localhost:8081
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=

# Keycloak (SSO)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=nexusai
KEYCLOAK_CLIENT_ID=nexusai-backend
KEYCLOAK_CLIENT_SECRET=change-this-secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# =============================================================================
# LANGFUSE (LLM Observability & Debugging)
# =============================================================================
# Get API keys from: Project -> Settings in your Langfuse dashboard
# Dashboard: https://us.cloud.langfuse.com (US) or https://cloud.langfuse.com (EU)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://us.cloud.langfuse.com
# Optional: Project and Organization IDs
LANGFUSE_PROJECT_ID=your-project-id
LANGFUSE_ORG_ID=your-org-id

# =============================================================================
# OBSERVABILITY (OpenTelemetry)
# =============================================================================

OTEL_ENABLED=false
OTEL_SERVICE_NAME=nexusai-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# =============================================================================
# CODE INTERPRETER / SANDBOX
# =============================================================================

CODE_SANDBOX_ENABLED=true
CODE_SANDBOX_URL=http://localhost:8090
SANDBOX_MAX_CONTAINERS=10
SANDBOX_TIMEOUT=30
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0

# =============================================================================
# SPEECH SERVICES
# =============================================================================

ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# =============================================================================
# IMAGE GENERATION
# =============================================================================

STABILITY_API_KEY=
REPLICATE_API_TOKEN=

# =============================================================================
# MULTI-TENANCY
# =============================================================================

MULTI_TENANT_ENABLED=true
DEFAULT_ORG_MAX_MEMBERS=5
DEFAULT_ORG_MAX_PROJECTS=3

# =============================================================================
# RATE LIMITING
# =============================================================================

RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# =============================================================================
# BACKGROUND TASKS
# =============================================================================

TASK_QUEUE_ENABLED=true
TASK_WORKER_CONCURRENCY=10

# =============================================================================
# FEATURE FLAGS
# =============================================================================

FEATURE_AI_ANALYTICS=true
FEATURE_CODE_SIMILARITY=true
FEATURE_PR_ISSUE_CORRELATION=true
FEATURE_SPACE_METRICS=true
FEATURE_BUSINESS_METRICS=true
FEATURE_PRODUCTIVITY_METRICS=true

# ChatInterface Features
FEATURE_CODE_INTERPRETER=true
FEATURE_WEB_SEARCH=true
FEATURE_IMAGE_GENERATION=true
FEATURE_SPEECH_STT=true
FEATURE_SPEECH_TTS=true
FEATURE_MCP_TOOLS=true
FEATURE_AGENT_HANDOFF=true
FEATURE_GENERATIVE_UI=true
FEATURE_CONVERSATION_IMPORT=true
FEATURE_CONVERSATION_EXPORT=true

# =============================================================================
# SYNTHETIC/DEMO MODE
# =============================================================================

# Enable synthetic data for demos without real AI connections
SYNTHETIC_MODE=false
SYNTHETIC_DATA_PATH=./data/synthetic

# =============================================================================
# PERSONAL ACCESS TOKENS
# =============================================================================

PAT_DEFAULT_EXPIRY_DAYS=90
PAT_MAX_TOKENS_PER_USER=10

# =============================================================================
# ADDITIONAL DATABASES (Optional)
# =============================================================================

# ClickHouse (Analytics OLAP)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=nexusai
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# MongoDB (Document Storage)
MONGODB_ROOT_USERNAME=root
MONGODB_ROOT_PASSWORD=change-this-password
MONGODB_DATABASE=nexusai
MONGODB_APP_PASSWORD=change-this-app-password

# =============================================================================
# DOCKER COMPOSE
# =============================================================================

DOMAIN=localhost
VERSION=latest
COMPOSE_PROJECT_NAME=nexusai
